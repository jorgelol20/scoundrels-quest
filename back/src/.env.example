# ========================================
# .ENV_EXAMPLE - Ejemplo de Variables de Entorno
# ----------------------------------------
# Copia este archivo como .env y edita los valores.
# ========================================


# --- CONFIGURACIÓN DE APLICACIÓN ---
APP_NAME="Scoundrel Game"
APP_ENV=local
# Ejecuta `php artisan key:generate` y pega aquí el valor resultante.
APP_KEY=
# NUNCA true en producción: en modo debug las trazas filtran variables de
# entorno, rutas y consultas SQL.
APP_DEBUG=false
APP_URL=http://api.localhost
FRONTEND_URL=http://localhost:5174

# Locale por defecto de la app y fallback de traducciones ('es' | 'en').
# Debe coincidir con SetLocale::SUPPORTED y su FALLBACK ('es').
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Orígenes permitidos por CORS (lista separada por comas).
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,https://xjorgelol20.itch.io/scoundrels-quest,https://html-classic.itch.zone"


# --- CONFIGURACIÓN DE LOGS ---
LOG_CHANNEL=stack
LOG_LEVEL=debug


# --- BASE DE DATOS (DOCKER) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=scoundrel
DB_USERNAME=master
# Sin credenciales reales en este archivo.
DB_PASSWORD=


# --- SESIONES Y SEGURIDAD (CRÍTICO PARA HTTPS) ---
# En producción: SESSION_SECURE_COOKIE=true y SESSION_SAME_SITE=lax
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Caducidad de los tokens de Sanctum (minutos). 0 = sin caducidad.
SANCTUM_EXPIRATION=10080


# --- CACHE Y COLAS ---
CACHE_STORE=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database


# --- GOOGLE AUTH ---
GOOGLE_CLIENTE_ID=[YOUR_GOOGLE_CLIENT_ID]
GOOGLE_CLIENTE_SECRET=[YOUR_GOOGLE_CLIENT_SECRET]
GOOGLE_REDIRECT_URI=http://api.localhost/api/auth/google/callback 


# --- X / TWITTER AUTH ---
TWITTER_CLIENT_ID=[YOUR_TWITTER_CLIENT_ID]
TWITTER_CLIENT_SECRET=[YOUR_TWITTER_CLIENT_SECRET]
TWITTER_REDIRECT_URI=http://api.localhost/api/auth/x/callback 


# --- BROADCASTING (WebSockets) ---
BROADCAST_CONNECTION=log

# --- CORREO ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.tuservidor.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo
MAIL_PASSWORD=tu_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=soporte@scoundrels-quest.com
MAIL_FROM_NAME="Scoundrel's Quest"