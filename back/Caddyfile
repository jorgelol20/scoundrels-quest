scoundrels-quest.com, http://localhost, :5174 {
    root * /srv/frontend
    encode gzip zstd

     @assets {
        path /assets/*
    }
    handle @assets {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

     @index {
        path /index.html /
    }
    header @index Cache-Control "no-cache, no-store, must-revalidate"

     handle {
        try_files {path} /index.html
        file_server
    }
}
api.scoundrels-quest.com, http://api.localhost {
  root * /var/www/public
  file_server
 
  encode gzip zstd

  php_fastcgi php:9000
  file_server
}